# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Environment
.env
backend/.env

# Uploads (local dev file storage)
backend/uploads/*
!backend/uploads/.gitkeep

# Protected documents (local dev private storage). A real playbook lands here
# during local testing, and a playbook committed to a public repo is the exact
# loss the private-storage design exists to prevent - so this is ignored
# wholesale, with no .gitkeep exception, and the directory is created at write
# time by LocalPrivateStorage.
backend/private_uploads/

# Editors / OS
.vscode/
.idea/
.DS_Store
.claude/

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
pytest_output.txt

# Load-test generated artifacts (seeded quiz/access-code/player data, run
# results) - regenerated fresh by backend/loadtest/seed.py every run, never
# meant to be committed. The scripts themselves ARE tracked.
backend/loadtest/loadtest_config.json
backend/loadtest/results/
backend/loadtest/*.csv
backend/loadtest/*.log
