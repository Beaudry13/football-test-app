# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Environment
.env
backend/.env

# Uploads (local dev file storage)
backend/uploads/*
!backend/uploads/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
