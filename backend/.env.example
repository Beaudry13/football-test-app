# Flask
FLASK_ENV=development
# Generate real values with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-random-32-byte-value
JWT_SECRET_KEY=change-me-too-use-a-different-random-32-byte-value

# Database
DATABASE_URL=postgresql://quiz_user:quiz_password@localhost:5432/football_quiz
TEST_DATABASE_URL=postgresql://quiz_user:quiz_password@localhost:5432/football_quiz_test

# File storage - "local" (disk, fine for dev) or "s3" (R2/S3-compatible
# bucket - required in production, since most hosts wipe local disk on
# every redeploy). See docs/DEPLOYMENT.md for how to set up an R2 bucket.
STORAGE_BACKEND=local
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE_MB=10

# Protected documents (playbook PDFs). Must live OUTSIDE UPLOAD_FOLDER, which
# the app serves wholesale at /uploads/<path> - a private asset underneath it
# would be downloadable by anyone.
PRIVATE_UPLOAD_FOLDER=private_uploads
PDF_MAX_UPLOAD_SIZE_MB=50
PDF_MAX_PAGES=400
# How long a signed media URL stays valid, in seconds.
SIGNED_MEDIA_TTL_SECONDS=600

# Only read when STORAGE_BACKEND=s3
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=

# A SEPARATE bucket for protected documents, with NO public access binding.
# Not a prefix inside R2_BUCKET_NAME: if that bucket's hostname is bound to
# its root, every object in it is world-readable whatever the key looks like.
# There is deliberately no public-URL-base setting for this bucket - nothing
# in the code can build a public URL for a private object.
# Required whenever STORAGE_BACKEND=s3; the app refuses to store a playbook
# rather than silently falling back to the public bucket.
R2_PRIVATE_BUCKET_NAME=

# CORS - comma-separated list of allowed origins. Include both localhost and
# 127.0.0.1 for the dev frontend since browsers treat them as different origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Access codes
ACCESS_CODE_TTL_HOURS=24
