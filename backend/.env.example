# Flask
FLASK_ENV=development
# Generate real values with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-random-32-byte-value
JWT_SECRET_KEY=change-me-too-use-a-different-random-32-byte-value

# Database
DATABASE_URL=postgresql://quiz_user:quiz_password@localhost:5432/football_quiz
TEST_DATABASE_URL=postgresql://quiz_user:quiz_password@localhost:5432/football_quiz_test

# File storage (local disk for now; swappable for S3-compatible storage later)
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE_MB=10

# CORS - comma-separated list of allowed origins. Include both localhost and
# 127.0.0.1 for the dev frontend since browsers treat them as different origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Access codes
ACCESS_CODE_TTL_HOURS=24
